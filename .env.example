# Copy to .env and edit. .env is git-ignored; never commit real passwords.

# --- General ---------------------------------------------------------------
TZ=America/Chicago

# --- Icecast ---------------------------------------------------------------
# LAN IP (or DNS name) of the Docker host. Icecast uses it in the URLs it
# advertises; the Nest Hub must be able to reach it. Never "localhost".
ICECAST_HOSTNAME=192.168.1.10
# Port Icecast listens on, published on the host with the same number.
ICECAST_PORT=8000
# Mount point; keep the .mp3 extension, Cast devices like it.
ICECAST_MOUNT=/lullaby.mp3
# Letters, digits, and - _ . only (they go into XML and a URL).
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
# Bytes sent instantly to a new listener. Smaller = less delay between
# rendering and hearing. 16384 is about 1 s at 128 kbps.
ICECAST_BURST_SIZE=16384

# --- Synth -----------------------------------------------------------------
# What the synth plays: "tone" (test tone, stage 1).
SYNTH_MODE=tone
# Host folders mounted into the synth container (read-only).
# On Unraid, use e.g. /mnt/user/appdata/lullaby-cast/soundfonts
SOUNDFONTS_HOST_DIR=./soundfonts
MIDI_HOST_DIR=./midi
# SoundFont file inside /soundfonts.
SOUNDFONT=/soundfonts/musicbox.sf2
SAMPLE_RATE=44100
MP3_BITRATE=128k
