# Copy to .env and edit. .env is git-ignored; never commit real passwords.

# --- General ---------------------------------------------------------------
TZ=America/Chicago

# --- Icecast ---------------------------------------------------------------
# LAN IP (or DNS name) of the Docker host. Icecast uses it in the URLs it
# advertises; the Nest Hub must be able to reach it. Never "localhost".
ICECAST_HOSTNAME=192.168.1.10
# Port Icecast listens on, published on the host with the same number.
ICECAST_PORT=8000
# Mount point; keep the .mp3 extension, Cast devices like it.
ICECAST_MOUNT=/lullaby.mp3
# Letters, digits, and - _ . only (they go into XML and a URL).
ICECAST_SOURCE_PASSWORD=change-me-source
ICECAST_ADMIN_PASSWORD=change-me-admin
# Bytes sent instantly to a new listener. Smaller = less delay between
# rendering and hearing. 16384 is about 1 s at 128 kbps.
ICECAST_BURST_SIZE=16384

# --- Synth -----------------------------------------------------------------
# What the synth plays:
#   playlist  every MIDI file in the folder, in a session (see SESSION_START)
#   file      loop one MIDI file (MIDI_FILE, or the first file in the folder)
#   tone      test tone, no FluidSynth needed
SYNTH_MODE=playlist
# When a playlist session runs:
#   listener  from when Icecast reports a listener (the Nest Hub connecting)
#             until none have been connected for SESSION_GRACE_SECONDS;
#             silence otherwise
#   always    one endless session
SESSION_START=listener
SESSION_GRACE_SECONDS=20
# Host folders mounted into the synth container (read-only).
# On Unraid, use e.g. /mnt/user/appdata/lullaby-cast/soundfonts
SOUNDFONTS_HOST_DIR=./soundfonts
MIDI_HOST_DIR=./midi
# SoundFont path inside the container (see README for where to get one).
SOUNDFONT=/soundfonts/GeneralUser-GS.sf2
# bank:preset to play every melodic channel on, ignoring the file's
# instruments. 0:10 is Music Box in General MIDI banks. "off" = as written.
FORCE_PRESET=0:10
# Drop drum notes (MIDI channel 10).
MUTE_PERCUSSION=true
# FluidSynth output level (its own default is 0.2, which is very quiet).
GAIN=0.8
# File to loop in "file" mode, inside the container, e.g. /midi/song.mid.
# Empty = first MIDI file in the folder.
MIDI_FILE=
# Seconds between plays (the last notes ring out during this time).
SONG_GAP_SECONDS=4
SAMPLE_RATE=44100
MP3_BITRATE=128k
